# Copy to .env and fill in. Every variable here must also be registered in
# .github/workflows/pipeline.yml (CI definition) and the container environment
# if you run tests in one — the "three registration points" rule.
# Tests run inside the container; a value set only in a CI step shell never
# reaches them.

# --- Application under test ---
BASE_URL=http://localhost:3000

# --- Model (OpenAI-compatible gateway) ---
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODEL_CONCURRENCY=4
# Optional. For reasoning models whose thinking consumes the whole max_tokens
# budget and returns null content: none | minimal | low | medium | high.
# MODEL_REASONING_EFFORT=none

# --- Repos and delivery (GitHub via gh CLI) ---
GH_TOKEN=
# WORK repo: where the generated tests are committed, pushed and opened as a PR. We never
# deliver into the product repo, so this is the test repo. Never auto-merged — the PR is
# the review gate, and it carries the run's test result and the scope the run covered.
WORK_REPO_SLUG=owner/name
# SOURCE repo: whose change is under test. The product CICD triggers this pipeline after
# its own deploy and passes the testing context with it, so stage 1 reads a PR over there
# (with `--pr`) while the work stays here. Leave it unset when the run is about a PR in
# the work repo itself.
# SOURCE_REPO_SLUG=owner/name
# Branch the delivery branch is based on. Empty = main.
SOURCE_BRANCH=main

# --- Report channel (Telegram) ---
# Where a run announces its result — the status, the scope it actually ran, the per-domain
# pass/fail, what it could not cover, and the HITL PR when stage 8 opened one. Both unset =
# no report is sent: a legitimate setup, and stage 9 says so rather than staying quiet. A
# report that fails to send FAILS that stage (non-fatal), so it is never mistaken for one
# that arrived.
# The token is a secret: it appears in no log, no run report and no summary, and redaction
# knows both its URL and its shape as a backstop. Find a chat id by messaging the bot, then:
#   curl -s "https://api.telegram.org/bot$TELEGRAM_API_KEY/getUpdates"
TELEGRAM_API_KEY=
TELEGRAM_CHAT_ID=

# --- Pipeline overrides ---
# A grep you supply, for running the pipeline with a filter of your own choosing —
# e.g. an end-to-end pass when only stages 1–2 changed and the full suite is a waste.
# ABSOLUTE when set: it IS the filter, the planner agent is skipped, and the floor
# ("everything generated this run always runs") is not applied. The run summary says
# so, and names any test this run wrote that your override leaves out.
# Never a standing value in the CI definition — that would pin every run — but it IS a
# `workflow_dispatch` input, so you can supply one for a single run without a shell:
#   gh workflow run test-pipeline -f pr=123 -f test_grep=@smoke
# TEST_GREP=@smoke

# --- Debug logging ---
# Turn on to follow a run while it happens: stage/stage transitions, which
# scenario is being classified, every AI request + response (model, budgets,
# messages, completion, token usage, duration), builder browser steps, locator
# heals and POM navigation/assertions. Long input is truncated with an ellipsis
# and the number of cut characters. Off unless truthy (1/true/yes/on).
DEBUG=false

# --- CI marker (set by GitHub Actions automatically) ---
# CI=true
