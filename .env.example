# Copy to .env and fill in. Every variable here must also be registered in
# .github/workflows/pipeline.yml (CI definition) and the container environment
# if you run tests in one — the "three registration points" rule.
# Tests run inside the container; a value set only in a CI step shell never
# reaches them.

# --- Application under test ---
BASE_URL=http://localhost:3000

# --- Model (OpenAI-compatible gateway) ---
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODEL_CONCURRENCY=4
# Optional. For reasoning models whose thinking consumes the whole max_tokens
# budget and returns null content: none | minimal | low | medium | high.
# MODEL_REASONING_EFFORT=none

# --- Delivery (GitHub via gh CLI) ---
GH_TOKEN=
REPO_SLUG=owner/name
SOURCE_BRANCH=main

# --- Pipeline overrides ---
# A grep you supply, for running the pipeline with a filter of your own choosing —
# e.g. an end-to-end pass when only stages 1–2 changed and the full suite is a waste.
# ABSOLUTE when set: it IS the filter, the planner agent is skipped, and the floor
# ("everything generated this run always runs") is not applied. The run summary says
# so, and names any test this run wrote that your override leaves out.
# Deliberately NOT in the CI definition — an override belongs to the command you typed,
# not to a standing value that would pin every run.
# TEST_GREP=@smoke

# --- Debug logging ---
# Turn on to follow a run while it happens: stage/stage transitions, which
# scenario is being classified, every AI request + response (model, budgets,
# messages, completion, token usage, duration), builder browser steps, locator
# heals and POM navigation/assertions. Long input is truncated with an ellipsis
# and the number of cut characters. Off unless truthy (1/true/yes/on).
DEBUG=false

# --- CI marker (set by GitHub Actions automatically) ---
# CI=true
