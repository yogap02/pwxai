%% 02-stage-2-digest — exported from WORKFLOW.md
%% paste into Excalidraw:  menu → Mermaid to Excalidraw

flowchart TD
    SC["scenario block
scenarios/&lt;domain&gt;.txt"] --> H{"does a block exist,
and does its content
hash equal the scenario's?"}
    H -- "equal" --> HOLD["held
kept verbatim — no model call"]
    H -- "moved" --> RED["re-digest
the scenario changed,
so the block is rewritten"]
    H -- "no block" --> CLS{"classifier
already covered?
can the POM express it?"}
    CLS -- "covered by an
existing test" --> COV["covered
no test is written"]
    CLS -- "the POM cannot
express the novel part" --> UNB["unbuildable
stage-4 work order, test.fixme"]
    CLS -- "novel, and
expressible" --> GEN["generated"]
    RED --> GEN
    GEN --> WRITE["written inside
// @digest:managed:start … end"]

    classDef gate fill:#FFF6E5,stroke:#B46A00,color:#212630
    classDef ok fill:#E6F6FB,stroke:#43B7DC,color:#145E77
    class H,CLS gate
    class HOLD,COV,UNB,GEN,WRITE ok
